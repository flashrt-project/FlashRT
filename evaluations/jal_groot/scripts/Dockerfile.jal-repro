# Standalone reconstruction of the measured JAL runtime; not yet rebuilt here.
# Build from project root, without the old host-local base image:
#   docker build -f scripts/Dockerfile.jal-repro -t groot-comparison-jal:repro .
# Official sources:
#   https://www.jetson-ai-lab.com/tutorials/groot_n17_on_thor/
#   https://github.com/NVIDIA/Isaac-GR00T/tree/9c7e746b2cd37a810070a98ef41d290a07e806c2/scripts/deployment/thor
FROM nvidia/cuda:13.0.0-devel-ubuntu24.04@sha256:1e8ac7a54c184a1af8ef2167f28fa98281892a835c981ebcddb1fad04bdd452d

ENV NVIDIA_DRIVER_CAPABILITIES=graphics,utility,compute \
    DEBIAN_FRONTEND=noninteractive

# These versions were read from the measured image. A vanished apt version is
# a reproducibility failure; do not silently replace it during a comparison.
RUN test "$(uname -m)" = aarch64 && \
    apt-get update && apt-get install -y --no-install-recommends \
      python3=3.12.3-0ubuntu2.1 python3.12=3.12.3-1ubuntu0.16 \
      python3-pip python3-venv \
      build-essential yasm cmake libtool git git-lfs pkg-config curl ca-certificates \
      libass-dev libfreetype6-dev libvorbis-dev autoconf automake texinfo tmux \
      ffmpeg=7:6.1.1-3ubuntu5 libnvpl-lapack0=0.4.0.1-1 libnvpl-blas0=0.6.0-1 && \
    apt-mark hold python3 python3.12 ffmpeg libnvpl-lapack0 libnvpl-blas0 && \
    rm -rf /var/lib/apt/lists/*

# Official Astral uv distribution, pinned to the observed tool version and both
# official manylinux aarch64 wheel hashes (glibc-selected by pip).
RUN printf '%s\n' 'uv==0.12.10 --hash=sha256:bd0afae6918795c6a61a649e64d735e339f3d62f8310235da6f19eb3f66f323b --hash=sha256:5c0bcf0598742eb417f1aa41ec82f0d89bd7b7f42d0a519bea495a9419d8d8ee' > /tmp/uv-requirements.txt && \
    python3 -m pip install --break-system-packages --only-binary=:all: \
      --require-hashes -r /tmp/uv-requirements.txt && rm /tmp/uv-requirements.txt

# Fetch only the public pinned source and its required TorchCodec LFS wheel;
# dataset/model downloads are supplied separately by the comparison workspace.
WORKDIR /workspace
RUN git init . && git remote add origin https://github.com/NVIDIA/Isaac-GR00T.git && \
    git fetch --depth 1 origin 9c7e746b2cd37a810070a98ef41d290a07e806c2 && \
    GIT_LFS_SKIP_SMUDGE=1 git checkout --detach FETCH_HEAD && \
    git lfs pull --include='scripts/deployment/thor/wheels/torchcodec-*.whl' --exclude='' && \
    test "$(git rev-parse HEAD)" = 9c7e746b2cd37a810070a98ef41d290a07e806c2 && \
    printf '%s\n' \
      'df3e43158d560228d774d0fce1d246755c99944cb9e018179bd63c31dda215e7  scripts/deployment/thor/uv.lock' \
      '1421de7e6248cc33398c16b2d7ba5ada4bf5c2a38af7cc44a003f3b0c36eb314  scripts/deployment/thor/wheels/torchcodec-0.10.0a0-cp312-cp312-linux_aarch64.whl' | sha256sum --check - && \
    curl -fL https://www.jetson-ai-lab.com/code-samples/groot_n17_on_thor/groot-n17-trt-optimization.patch -o /tmp/jal.patch && \
    printf '%s\n' '6a818bfcbb149c0f0efa8567ecc0fd6909613bc53e00e08f66bb81c8c601d5a3  /tmp/jal.patch' | sha256sum --check - && \
    git apply --check /tmp/jal.patch && git apply /tmp/jal.patch && rm /tmp/jal.patch

# Reuse upstream install logic, with lock regeneration explicitly disabled.
# It obtains GPU wheels from the official Jetson AI Lab sbsa/cu130 index.
ENV DOCKER_CONTAINER=1 \
    UV_PROJECT_ENVIRONMENT=/opt/gr00t-venv \
    UV_FROZEN=1
RUN bash scripts/deployment/thor/install_deps.sh

ENV VIRTUAL_ENV=/opt/gr00t-venv
ENV PATH="/opt/gr00t-venv/bin:/usr/local/bin:/usr/local/cuda/bin:${PATH}" \
    TRITON_PTXAS_PATH=/usr/local/cuda/bin/ptxas \
    CUDA_HOME=/usr/local/cuda-13.0 \
    CUDA_PATH=/usr/local/cuda-13.0 \
    CPATH=/usr/local/cuda-13.0/include \
    C_INCLUDE_PATH=/usr/local/cuda-13.0/include \
    CPLUS_INCLUDE_PATH=/usr/local/cuda-13.0/include
ENV LD_LIBRARY_PATH="/opt/gr00t-venv/lib/python3.12/site-packages/torch/lib:/opt/gr00t-venv/lib/python3.12/site-packages/nvidia/cu13/lib:/opt/gr00t-venv/lib/python3.12/site-packages/nvidia/cudss/lib:/opt/gr00t-venv/lib/python3.12/site-packages/nvidia/cudnn/lib:${LD_LIBRARY_PATH}"
COPY scripts/jal-runtime-constraints.txt /opt/jal-runtime-constraints.txt

# JAL Step 9.1, constrained to the complete observed Python environment.
# ModelOpt changes ONNX 1.20.1 from the upstream lock to 1.19.1, as observed.
RUN uv pip install --python /opt/gr00t-venv/bin/python \
      --constraint /opt/jal-runtime-constraints.txt 'nvidia-modelopt[onnx]==0.39.0' && \
    /opt/gr00t-venv/bin/python -c "import importlib.metadata as m,pathlib; pins=[line.strip().split('==') for line in pathlib.Path('/opt/jal-runtime-constraints.txt').read_text().splitlines() if line and not line.startswith('#')]; mismatch=[(name,version,m.version(name)) for name,version in pins if m.version(name)!=version]; assert not mismatch, mismatch; print('Verified',len(pins),'Python package versions; torch',m.version('torch'),'TensorRT',m.version('tensorrt'),'ModelOpt',m.version('nvidia-modelopt'))"

WORKDIR /comparison
ENV PYTHONPATH=/comparison/vendor/Isaac-GR00T:/comparison:/workspace
CMD ["bash"]
